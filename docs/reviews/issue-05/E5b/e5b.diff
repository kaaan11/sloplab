+def _require_authorized(document: ReportDocument, section: ReportSection) -> None:
+    """Reject splices whose span is not authorized for this exact document."""
+    if not span_authorized(
+        document, section, expected_document_identity=document_identity(document)
+    ):
+        raise StaleSpanError(
+            f"span {section.location} is not authorized for document "
+            f"'{document.fixture_id}' (stale or foreign span)"
+        )
