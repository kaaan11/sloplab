+def begin_publish(out_dir: Path, *, kind: str) -> Path:
+    """Open a publish cycle: mark in-progress, retire any older completion.
+
+    Idempotent. Call before any output mutation or model dispatch, so a
+    republish over a completed directory stops being consumable the moment
+    the new run starts — long before its own completion exists.
+    """
+    if kind not in BUNDLE_KINDS:
+        raise BundleError(f"unknown bundle kind {kind!r}")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    marker = out_dir / COMPLETION_FILE_NAME
+    if marker.is_file():
+        marker.unlink()
+    progress = out_dir / IN_PROGRESS_FILE_NAME
+    progress.write_text(
+        json.dumps(
+            {"bundle_schema": BUNDLE_SCHEMA_VERSION, "kind": kind, "state": "in-progress"},
+            sort_keys=True,
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    return progress
+
+
+def finish_publish(out_dir: Path, *, kind: str) -> Path:
+    """Close a publish cycle: write a verifiable completion, then unmark.
+
+    The completion map covers data files only. The in-progress marker is
+    removed last; only afterwards does the bundle read ``complete``. A
+    crash between the two steps leaves both files behind and every reader
+    still refuses.
+    """
+    marker = write_completion(out_dir, kind=kind)
+    progress = out_dir / IN_PROGRESS_FILE_NAME
+    if progress.is_file():
+        progress.unlink()
+    return marker
+
+
