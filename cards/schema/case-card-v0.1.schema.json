{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kaaan11/sloplab/main/cards/schema/case-card-v0.1.schema.json",
  "title": "SlopLab case-card-v0.1",
  "description": "Structural format only. This schema does not validate evidence truth, human review, equivalence, policy compliance, or semantic safety.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "case-card-v0.1"
    },
    "card_id": {
      "type": "string",
      "pattern": "^c[0-9]{2,}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "license": {
      "const": "CC0-1.0"
    },
    "fully_synthetic": {
      "const": true
    },
    "input": {
      "$ref": "#/$defs/visible_input"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "required": [
    "schema_version",
    "card_id",
    "scenario_id",
    "revision",
    "title",
    "language",
    "license",
    "fully_synthetic",
    "input",
    "review",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "visible_input": {
      "type": "object",
      "properties": {
        "opaque_id": {
          "type": "string",
          "pattern": "^case-[a-z0-9]{8,32}$"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^P[0-9]{1,3}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "setting",
                  "stipulated_fact",
                  "program_policy",
                  "assistant_role"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "report": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[0-9]{2}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E[0-9]{1,2}$"
              },
              "origin": {
                "type": "string",
                "enum": [
                  "stipulated_synthetic_artifact",
                  "synthetic_reporter_assertion"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "origin",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C[0-9]{1,2}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "report_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "statement",
              "report_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "schema_version": {
          "const": "case-card-v0.1"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "opaque_id",
        "context",
        "report",
        "artifacts",
        "claims"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "failure_mode_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FM[0-9]{2,}$"
          },
          "minItems": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "finding_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R[12]-[0-9]{3}$"
          },
          "minItems": 0
        },
        "claim_evidence_map": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "supported",
                  "missing",
                  "contradictory"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "blocks_core_verification": {
                "type": "boolean"
              }
            },
            "required": [
              "claim_id",
              "status",
              "evidence_refs",
              "explanation",
              "blocks_core_verification"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "next_action": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "enum": [
                "verify",
                "request_specific_information",
                "likely_out_of_scope"
              ]
            },
            "verification_claim_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "verification_question": {
              "type": "string",
              "minLength": 1
            },
            "blocking_requests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "non_blocking_requests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "policy_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "primary",
            "verification_claim_ids",
            "verification_question",
            "blocking_requests",
            "non_blocking_requests",
            "policy_refs"
          ],
          "additionalProperties": false
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "confidence_scope": {
          "type": "string",
          "minLength": 1
        },
        "counterconditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "alternative_action": {
                "type": "string",
                "enum": [
                  "verify",
                  "request_specific_information",
                  "likely_out_of_scope"
                ]
              }
            },
            "required": [
              "condition",
              "alternative_action"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft_unreviewed",
            "owner_adjudicated",
            "external_subset_reviewed",
            "unresolved_discussion"
          ]
        }
      },
      "required": [
        "failure_mode_ids",
        "why_it_matters",
        "finding_refs",
        "claim_evidence_map",
        "next_action",
        "confidence",
        "confidence_scope",
        "counterconditions",
        "status"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authoring_model_family": {
          "type": "string",
          "minLength": 1
        },
        "authoring_model_product": {
          "type": "string",
          "minLength": 1
        },
        "authored_date": {
          "type": "string",
          "format": "date"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$"
        },
        "source_fixture_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R[12]-[0-9]{3}$"
          },
          "minItems": 0
        },
        "public_source_ancestry": {
          "type": "boolean"
        },
        "first_publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "prior_exposure_note": {
          "type": "string",
          "minLength": 1
        },
        "panel_excluded_families": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "licensing_status": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_annotation_status": {
          "type": "string",
          "enum": [
            "not_run",
            "partial",
            "complete"
          ]
        },
        "owner_review_status": {
          "type": "string",
          "enum": [
            "not_started",
            "pre_vote_recorded",
            "adjudicated"
          ]
        },
        "external_review_status": {
          "type": "string",
          "enum": [
            "none",
            "requested",
            "completed_for_disclosed_subset"
          ]
        }
      },
      "required": [
        "authoring_model_family",
        "authoring_model_product",
        "authored_date",
        "source_commit",
        "source_fixture_paths",
        "source_finding_ids",
        "public_source_ancestry",
        "first_publication_date",
        "prior_exposure_note",
        "panel_excluded_families",
        "licensing_status",
        "input_sha256",
        "model_annotation_status",
        "owner_review_status",
        "external_review_status"
      ],
      "additionalProperties": false
    }
  }
}
