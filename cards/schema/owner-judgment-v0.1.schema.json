{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kaaan11/sloplab/main/cards/schema/owner-judgment-v0.1.schema.json",
  "title": "SlopLab owner-judgment-v0.1",
  "description": "The case owner's blind judgment over one card's input view: one proposed action for the card, an ordinal confidence, a one-line rationale, and a per-claim evidence status. Written before the answer key is seen.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "owner-judgment-v0.1"
    },
    "card_id": {
      "type": "string",
      "pattern": "^c[0-9]{2,}$"
    },
    "judge": {
      "type": "string",
      "minLength": 1
    },
    "judged_date": {
      "type": "string",
      "format": "date"
    },
    "action": {
      "type": "string",
      "enum": [
        "verify",
        "request_specific_information",
        "likely_out_of_scope"
      ]
    },
    "action_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C[0-9]{1,2}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]*$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[0-9]{1,2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "missing",
              "contradictory"
            ]
          },
          "note": {
            "type": "string",
            "pattern": "^[^\\n\\r]*$"
          }
        },
        "required": [
          "claim_id",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "card_id",
    "judge",
    "judged_date",
    "action",
    "confidence",
    "rationale",
    "claims"
  ],
  "additionalProperties": false
}
